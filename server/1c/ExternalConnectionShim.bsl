// КЕРМО: заглушки клиентского интерфейса для внешнего соединения 1С 8.1 (шлюз).
// Вставляется в «Модуль внешнего соединения» утилитой migration/tools/cf_patch.py; модули объектов вендора не меняются.
// Вопросы и предупреждения не блокируют выполнение: ответ берётся из глШлюзОтветы (по порядку), иначе «Нет».
// Все диалоги копятся в глШлюзДиалоги, шлюз возвращает их клиенту для подтверждения.
Перем КодВозвратаДиалога Экспорт;
Перем РежимДиалогаВопрос Экспорт;
Перем ВариантПоложенияОкна Экспорт;
Перем РабочаяДата Экспорт;
Перем глПрава Экспорт;
Перем глШлюзДиалоги Экспорт;
Перем глШлюзОтветы Экспорт;
Перем глШлюзСчетчик Экспорт;
Перем глШлюзОшибкаПрав Экспорт;
//----CODE----
Процедура ПриНачалеРаботыСистемы()
	ШлюзИнициализация();
	глШлюзОшибкаПрав = "";
	Попытка
		Выполнить("глПрава = обПолучитьПраваИНастройкиПользователя(ПараметрыСеанса.Пользователь)");
	Исключение
		глПрава = Неопределено;
		глШлюзОшибкаПрав = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

Процедура ШлюзИнициализация() Экспорт
	КодВозвратаДиалога = Новый Структура("Да,Нет,ОК,Отмена,Повторить,Прервать,Пропустить,Игнорировать,Таймаут", "Да", "Нет", "ОК", "Отмена", "Повторить", "Прервать", "Пропустить", "Игнорировать", "Таймаут");
	РежимДиалогаВопрос = Новый Структура("ДаНет,ДаНетОтмена,ОК,ОКОтмена,ПовторитьОтмена,ПрерватьПовторитьПропустить", "ДаНет", "ДаНетОтмена", "ОК", "ОКОтмена", "ПовторитьОтмена", "ПрерватьПовторитьПропустить");
	ВариантПоложенияОкна = Новый Структура;
	РабочаяДата = НачалоДня(ТекущаяДата());
	ШлюзСброс();
КонецПроцедуры

Процедура ШлюзСброс(Ответы = Неопределено) Экспорт
	глШлюзДиалоги = Новый Массив;
	глШлюзОтветы = Новый Массив;
	Если ТипЗнч(Ответы) = Тип("Массив") Тогда
		Для Каждого Элемент Из Ответы Цикл
			глШлюзОтветы.Добавить(Элемент);
		КонецЦикла;
	КонецЕсли;
	глШлюзСчетчик = 0;
КонецПроцедуры

Процедура ШлюзЗаписатьДиалог(ВидДиалога, ТекстДиалога, ОтветДиалога)
	Если ТипЗнч(глШлюзДиалоги) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	глШлюзДиалоги.Добавить(Новый Структура("Вид,Текст,Ответ", ВидДиалога, ТекстДиалога, ОтветДиалога));
КонецПроцедуры

Функция Вопрос(ТекстВопроса, Режим = Неопределено, Таймаут = 0, КнопкаПоУмолчанию = Неопределено, Заголовок = "", КодВозвратаТаймаута = Неопределено) Экспорт
	Если РежимДиалогаВопрос = Неопределено Тогда
		ШлюзИнициализация();
	КонецЕсли;
	Если Режим = РежимДиалогаВопрос.ОК ИЛИ Режим = РежимДиалогаВопрос.ОКОтмена Тогда
		Ответ = КодВозвратаДиалога.ОК;
	Иначе
		Ответ = КодВозвратаДиалога.Нет;
		Если глШлюзСчетчик < глШлюзОтветы.Количество() Тогда
			Если глШлюзОтветы[глШлюзСчетчик] = "Да" Тогда
				Ответ = КодВозвратаДиалога.Да;
			КонецЕсли;
		КонецЕсли;
		глШлюзСчетчик = глШлюзСчетчик + 1;
	КонецЕсли;
	ШлюзЗаписатьДиалог("Вопрос", ТекстВопроса, Ответ);
	Возврат Ответ;
КонецФункции

Процедура Предупреждение(ТекстПредупреждения, Таймаут = 0, Заголовок = "") Экспорт
	ШлюзЗаписатьДиалог("Предупреждение", ТекстПредупреждения, "ОК");
КонецПроцедуры

Процедура Состояние(ТекстСообщения = "", Прогресс = 0, ПояснениеПрогресса = "", Картинка = Неопределено) Экспорт
КонецПроцедуры

Функция ВвестиДату(Значение, Подсказка = "", ЧастьДаты = Неопределено) Экспорт
	Возврат Ложь;
КонецФункции

Функция ВвестиЧисло(Значение, Подсказка = "", Длина = 0, Точность = 0) Экспорт
	Возврат Ложь;
КонецФункции

Функция ВвестиСтроку(Значение, Подсказка = "", Длина = 0, Многострочная = Ложь) Экспорт
	Возврат Ложь;
КонецФункции

Функция ВвестиЗначение(Значение, Подсказка = "", ТипЗначения = Неопределено) Экспорт
	Возврат Ложь;
КонецФункции
